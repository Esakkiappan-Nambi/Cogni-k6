
pipeline {
    agent any

    environment {
        FRONTEND_IMAGE = 'k6-frontend'
        BACKEND_IMAGE = 'k6-backend'
        IMAGE_TAG = 'latest'
        FRONTEND_PORT = '8081'
        BACKEND_PORT = '8000'
        RECORDER_DATA_VOLUME = 'k6-recorder-data'
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out K6 Performance Portal source code'
                checkout scm
            }
        }

        stage('Check Docker') {
            steps {
                sh '''
                    docker --version
                    docker info
                '''
            }
        }

        stage('Build Frontend Image') {
            steps {
                sh '''
                    docker build \
                      -t ${FRONTEND_IMAGE}:${IMAGE_TAG} \
                      ./Frontend/k6-UI
                '''
            }
        }

        stage('Build Backend Image') {
            steps {
                sh '''
                    docker build \
                      -t ${BACKEND_IMAGE}:${IMAGE_TAG} \
                      ./Backend
                '''
            }
        }

stage('Deploy Backend') {
    steps {
        withCredentials([
            string(credentialsId: 'k6-database-url', variable: 'DATABASE_URL'),
            string(credentialsId: 'k6-secret-key', variable: 'SECRET_KEY')
        ]) {
            sh '''
                docker volume create "$RECORDER_DATA_VOLUME" >/dev/null

                if docker inspect k6-backend >/dev/null 2>&1; then
                    docker run --rm \
                        --user 0:0 \
                        --volumes-from k6-backend:ro \
                        -v "$RECORDER_DATA_VOLUME:/recorder-data" \
                        --entrypoint sh \
                        "${BACKEND_IMAGE}:${IMAGE_TAG}" \
                        -c 'if [ -z "$(ls -A /recorder-data 2>/dev/null)" ]; then cp -a /app/recorder_sessions/. /recorder-data/; chown -R app:app /recorder-data; fi'
                fi

                docker rm -f k6-backend || true

                docker run -d \
                    --name k6-backend \
                    --restart unless-stopped \
                    -v "$RECORDER_DATA_VOLUME:/app/recorder_sessions" \
                    -p 8000:8000 \
                    -p 127.0.0.1:8888:8888 \
                    -e DATABASE_URL="$DATABASE_URL" \
                    -e SECRET_KEY="$SECRET_KEY" \
                    -e CORS_ORIGINS="http://localhost:8081,http://127.0.0.1:8081" \
                    k6-backend:latest
            '''
        }
    }
}

       stage('Deploy Frontend') {
            steps {
                sh '''
                    docker rm -f k6-frontend || true

                    docker run -d \
                      --name k6-frontend \
                      --restart unless-stopped \
                      -p ${FRONTEND_PORT}:5173 \
                      ${FRONTEND_IMAGE}:${IMAGE_TAG}
                '''
            }
        }
        stage('Verify Deployment') {
            steps {
                sh '''
                    docker ps
                    echo "Frontend: http://localhost:8080"
                    echo "Backend: http://localhost:8000/docs"
                '''
            }
        }
    }

    post {
        success {
            echo 'K6 Performance Portal deployed successfully!'
        }

        failure {
            echo 'Deployment failed. Check the Jenkins Console Output.'
        }
    }
}
