
pipeline {
    agent any

    environment {
        FRONTEND_IMAGE = 'k6-frontend'
        BACKEND_IMAGE = 'k6-backend'
        IMAGE_TAG = 'latest'
        FRONTEND_PORT = '8081'
        BACKEND_PORT = '8000'
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out K6 Performance Portal source code'
                checkout scm
            }
        }

        stage('Check Docker') {
            steps {
                sh '''
                    docker --version
                    docker info
                '''
            }
        }

        stage('Build Frontend Image') {
            steps {
                sh '''
                    docker build \
                      -t ${FRONTEND_IMAGE}:${IMAGE_TAG} \
                      ./Frontend/k6-UI
                '''
            }
        }

        stage('Build Backend Image') {
            steps {
                sh '''
                    docker build \
                      -t ${BACKEND_IMAGE}:${IMAGE_TAG} \
                      ./Backend
                '''
            }
        }

stage('Deploy Backend') {
    steps {
        withCredentials([
            string(
                credentialsId: 'k6-database-url',
                variable: 'DATABASE_URL'
            ),
            string(
                credentialsId: 'k6-secret-key',
                variable: 'SECRET_KEY'
            )
        ]) {
            sh '''
                docker rm -f k6-backend || true

                docker run -d \
                  --name k6-backend \
                  --restart unless-stopped \
                  -p 8000:8000 \
                  -e DATABASE_URL="$DATABASE_URL" \
                  -e SECRET_KEY="$SECRET_KEY" \
                  k6-backend:latest
            '''
        }
    }
}

        stage('Deploy Frontend') {
            steps {
                sh '''
                    docker rm -f k6-frontend || true

                    docker run -d \
                      --name k6-frontend \
                      --restart unless-stopped \
                      -p ${FRONTEND_PORT}:80 \
                      ${FRONTEND_IMAGE}:${IMAGE_TAG}
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                    docker ps
                    echo "Frontend: http://localhost:8080"
                    echo "Backend: http://localhost:8000/docs"
                '''
            }
        }
    }

    post {
        success {
            echo 'K6 Performance Portal deployed successfully!'
        }

        failure {
            echo 'Deployment failed. Check the Jenkins Console Output.'
        }
    }
}
