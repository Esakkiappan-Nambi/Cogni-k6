pipeline {
    agent any

    parameters {
        string(name: 'BRANCH', defaultValue: 'main', description: 'RemediGuard patch branch to verify')
        string(name: 'FINDING_ID', defaultValue: '', description: 'RemediGuard finding id, for correlation in logs')
    }

    environment {
        JENKINS_HOME_VOLUME = 'jenkins_home'
    }


    stages {
        stage('Checkout patch branch') {
            steps {
                // Uses the same repo/credentials as the job's SCM config, but checks out the BRANCH parameter
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "*/${params.BRANCH}"]],
                    userRemoteConfigs: scm.userRemoteConfigs
                ])
                sh 'git clean -fdx'
            }
        }
        stage('Preflight') {
            steps {
                sh 'command -v jq'
                sh 'command -v docker'
                echo "Verifying finding ${params.FINDING_ID} on branch ${params.BRANCH}"
                sh 'git log -1 --oneline'
            }
        }

        stage('Build check') {
            steps {
                sh '''
                  set +e
                  docker run --rm -v jenkins_home:/var/jenkins_home -w "$WORKSPACE/Frontend/k6-UI" node:22-alpine \
                    sh -c "npm ci --no-audit --no-fund && npm run lint && npm run build" \
                    > build-output.log 2>&1
                  BUILD_EXIT_CODE=$?
                  echo "$BUILD_EXIT_CODE" > build-exit-code
                  cat build-output.log
                  echo "build exit code: ${BUILD_EXIT_CODE}"
                '''
            }
        }

        stage('Re-scan') {
            steps {
                sh '''
                  set +e
                  rm -f semgrep-rescan.json trivy-rescan.json

                  # Make sure Trivy has a lockfile to read
                  docker run --rm -v "${JENKINS_HOME_VOLUME}:/var/jenkins_home" -w "$WORKSPACE" node:22-alpine \
                    npm install --package-lock-only --no-audit --no-fund

                  docker run --rm -v "${JENKINS_HOME_VOLUME}:/var/jenkins_home" -w "$WORKSPACE" \
                    semgrep/semgrep semgrep scan --config auto \
                      --error \
                      --exclude '**/reports/**' --exclude '**/venv/**' \
                      --exclude '**/generated_scripts/**' \
                      --exclude '**/recorder_sessions/**' \
                      --exclude '**/node_modules/**' \
                      --json --output semgrep-rescan.json .
                  echo $? > semgrep-exit-code

                  docker run --rm -v "${JENKINS_HOME_VOLUME}:/var/jenkins_home" -w "$WORKSPACE" \
                    aquasec/trivy fs --exit-code 1 --severity HIGH,CRITICAL \
                      --skip-dirs reports \
                      --skip-dirs Backend/reports --skip-dirs Backend/venv \
                      --skip-dirs Backend/generated_scripts \
                      --skip-dirs Backend/recorder_sessions \
                      --skip-dirs Frontend/k6-UI/node_modules \
                      --skip-dirs Frontend/k6-UI/dist \
                      --format json --output trivy-rescan.json .
                  echo $? > trivy-exit-code

                  echo "semgrep exit: $(cat semgrep-exit-code), trivy exit: $(cat trivy-exit-code)"
                  exit 0
                '''
            }
        }

        stage('Publish verification result') {
            steps {
                sh '''
                  docker run --rm -i -v jenkins_home:/var/jenkins_home -w "$WORKSPACE" python:3.12-slim python3 - <<'PYEOF'
import json

build_ok = True
try:
    with open("build-output.log") as f:
        log = f.read()
    with open("build-exit-code") as f:
        build_ok = f.read().strip() == "0" and "error TS" not in log
except FileNotFoundError:
    build_ok = False

try:
    with open("semgrep-rescan.json") as f:
        semgrep_rescan = json.load(f)
except (FileNotFoundError, json.JSONDecodeError):
    semgrep_rescan = {"results": []}

try:
    with open("trivy-rescan.json") as f:
        trivy_rescan = json.load(f)
except (FileNotFoundError, json.JSONDecodeError):
    trivy_rescan = {"Results": []}

rescan_clean = (
    len(semgrep_rescan.get("results", [])) == 0
    and all(
        not any(r.get(key) for key in ("Vulnerabilities", "Secrets", "Misconfigurations"))
        for r in trivy_rescan.get("Results", [])
    )
)

with open("results.json", "w") as f:
    json.dump({
        "tests_passed": build_ok,
        "rescan_clean": rescan_clean,
        "details": {
            "semgrep_remaining": len(semgrep_rescan.get("results", [])),
        },
    }, f, indent=2)
PYEOF
                  cat results.json
                '''
                archiveArtifacts artifacts: 'results.json', fingerprint: true
            }
        }
    }
}
