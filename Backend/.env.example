# Replace with a unique random value of at least 32 bytes; never use the placeholder in production.
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=2
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Replace this placeholder with your PostgreSQL connection URL. In Docker, use
# the database service name or host.docker.internal instead of localhost.
DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/k6_portal

# Comma-separated destination authorities (host or host:port) for /preview-step.
# The endpoint rejects all preview requests when this list is empty.
K6_PREVIEW_ALLOWED_HOSTS=
